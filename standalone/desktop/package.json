{
  "name": "ss-material-data-calculator",
  "productName": "SSMaterialDataCalc",
  "version": "1.1.0",
  "description": "材料数据计算 · 离线冲片计算工具（桌面版）",
  "author": {
    "name": "Yujay-Si",
    "url": "https://github.com/Yujay-Si/MatManager"
  },
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.yujaysi.materialcalculator",
    "productName": "SSMaterialDataCalc",
    "copyright": "Copyright © 2026 Yujay-Si",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web",
        "to": "calculator",
        "filter": [
          "index.html",
          "assets/**/*",
          "src/**/*",
          "vendor/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "SSMaterialDataCalc-1.1.0-portable.${ext}",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "SSMaterialDataCalc-1.1.0-portable.exe",
      "requestExecutionLevel": "user"
    },
    "compression": "normal"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.0.12"
  }
}
