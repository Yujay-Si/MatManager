/* 全局样式：深绿 #173e30 + 米白 #f4f5f1，与 Web 版视觉保持一致 */

page {
  background: #f4f5f1;
  color: #1f2c2b;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

view, text, input, textarea, button, picker, label, scroll-view {
  box-sizing: border-box;
}

.page {
  padding: 24rpx 24rpx 60rpx;
}

/* 顶部说明区 */
.page-head {
  padding: 8rpx 8rpx 28rpx;
}

.page-eyebrow {
  color: #64716d;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #173e30;
  letter-spacing: -1rpx;
  line-height: 1.25;
}

.page-desc {
  margin-top: 12rpx;
  color: #5f6f65;
  font-size: 24rpx;
  line-height: 1.75;
}

/* 卡片 */
.card {
  background: #ffffff;
  border: 1rpx solid #e1e6e0;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(25, 49, 39, 0.05);
}

.card-tight {
  padding: 22rpx 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #173e30;
}

.section-sub {
  color: #7a877f;
  font-size: 22rpx;
}

/* 表单 */
.field {
  margin-bottom: 24rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #2b3f36;
  font-size: 26rpx;
  font-weight: 650;
}

.field-label .unit {
  color: #78847c;
  font-size: 22rpx;
  font-weight: 400;
}

.field-hint {
  margin-top: 10rpx;
  color: #8b968e;
  font-size: 22rpx;
  line-height: 1.6;
}

.input,
.textarea,
.picker-box {
  width: 100%;
  border: 1rpx solid #d5ded7;
  border-radius: 16rpx;
  background: #ffffff;
  color: #1f2c2b;
  font-size: 28rpx;
}

.input {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
}

.textarea {
  min-height: 240rpx;
  padding: 20rpx 24rpx;
  line-height: 1.6;
  font-family: Consolas, "PingFang SC", monospace;
  font-size: 24rpx;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.picker-box .arrow {
  color: #9aa59d;
  font-size: 22rpx;
}

.row2 {
  display: flex;
  gap: 20rpx;
}

.row2 .field {
  flex: 1;
  min-width: 0;
}

/* 单选胶囊 */
.choice-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.choice {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #dce4dc;
  border-radius: 18rpx;
  background: #ffffff;
}

.choice.active {
  border-color: #479264;
  background: #f0f7ef;
}

.choice-mark {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #bcc9c0;
  border-radius: 50%;
  background: #ffffff;
  flex: 0 0 32rpx;
}

.choice.active .choice-mark {
  border-color: #276e49;
  border-width: 10rpx;
}

.choice-body {
  flex: 1;
  min-width: 0;
}

.choice-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #22382d;
}

.choice-desc {
  display: block;
  margin-top: 2rpx;
  color: #68766d;
  font-size: 22rpx;
}

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1;
  border: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #173e30;
  color: #f4f5f1;
  box-shadow: 0 10rpx 24rpx rgba(23, 62, 48, 0.18);
}

.btn-primary.btn-hover {
  background: #23553f;
}

.btn-secondary {
  background: #ffffff;
  color: #245c3d;
  border: 1rpx solid #c6d5c9;
}

.btn-secondary.btn-hover {
  background: #eef4ee;
}

.btn-danger {
  background: #ffffff;
  color: #9c392d;
  border: 1rpx solid #e6c9c4;
}

.btn-danger.btn-hover {
  background: #fdf1ef;
}

.btn-small {
  height: 68rpx;
  font-size: 24rpx;
  border-radius: 14rpx;
  padding: 0 22rpx;
}

.btn-block {
  width: 100%;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn-row .btn {
  flex: 1;
}

/* 结果区 */
.result-hero {
  padding: 28rpx;
  border-radius: 20rpx;
  background: #173e30;
  color: #eaf3ec;
}

.result-caption {
  font-size: 24rpx;
  color: #b7cdbe;
}

.result-value {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 10rpx;
}

.result-number {
  font-size: 68rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
  color: #ffffff;
  line-height: 1.1;
}

.result-unit {
  font-size: 26rpx;
  color: #b7cdbe;
}

.result-basis {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #a9c2b1;
  line-height: 1.6;
}

.kv-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.kv-item {
  width: 50%;
  padding: 12rpx 8rpx;
}

.kv-label {
  display: block;
  color: #7a877f;
  font-size: 22rpx;
}

.kv-value {
  display: block;
  margin-top: 4rpx;
  color: #1f2c2b;
  font-size: 26rpx;
  font-weight: 650;
  word-break: break-all;
}

.kv-wide {
  width: 100%;
}

.sub-title {
  margin: 26rpx 0 8rpx;
  color: #45604d;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.divider {
  height: 1rpx;
  background: #e7ece7;
  margin: 22rpx 0;
}

/* 状态与提示 */
.status {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #eef4ee;
  color: #2f6b48;
  font-size: 24rpx;
  line-height: 1.6;
}

.status.is-error {
  background: #fdf1ef;
  color: #9c392d;
}

.note {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #f7f5ec;
  border: 1rpx solid #eae4d2;
  color: #6b6547;
  font-size: 23rpx;
  line-height: 1.7;
}

.note-title {
  display: block;
  margin-bottom: 6rpx;
  color: #4f4a30;
  font-size: 24rpx;
  font-weight: 700;
}

.empty {
  padding: 60rpx 24rpx;
  text-align: center;
  color: #8b968e;
  font-size: 26rpx;
}

.empty-symbol {
  display: block;
  margin-bottom: 12rpx;
  font-size: 56rpx;
  color: #c3d0c6;
}

/* 列表 */
.list-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef1ec;
}

.list-item:last-child {
  border-bottom: none;
}

.item-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-number {
  font-size: 34rpx;
  font-weight: 800;
  color: #173e30;
}

.item-meta {
  display: block;
  margin-top: 4rpx;
  color: #7a877f;
  font-size: 22rpx;
}

.item-actions {
  display: flex;
  gap: 12rpx;
  flex: 0 0 auto;
}

.item-detail {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #f7f9f6;
}

.badge {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.badge-ok {
  background: #dceee1;
  color: #173e30;
}

.badge-error {
  background: #fbe3df;
  color: #9c392d;
}

.badge-muted {
  background: #edf0ed;
  color: #6b6f6c;
}

.table-wrap {
  border: 1rpx solid #e7ece7;
  border-radius: 16rpx;
  overflow: hidden;
}

.table-head,
.table-row {
  display: flex;
  font-size: 22rpx;
}

.table-head {
  background: #f2f5f1;
  color: #52655b;
  font-weight: 700;
}

.table-row {
  border-top: 1rpx solid #eef1ec;
}

.table-row.is-error {
  background: #fdf7f5;
}

.cell {
  padding: 14rpx 10rpx;
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.cell-narrow {
  flex: 0 0 84rpx;
  text-align: center;
}

.footer-note {
  margin: 30rpx 8rpx 0;
  color: #8b968e;
  font-size: 22rpx;
  line-height: 1.7;
  text-align: center;
}
