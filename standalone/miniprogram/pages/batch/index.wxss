.template-demo {
  margin-top: 8rpx;
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
  background: #ffffff;
  color: #45604d;
  font-family: Consolas, monospace;
  font-size: 22rpx;
}

.template-field {
  margin-top: 26rpx;
}

.file-chip {
  margin-top: 12rpx;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: #eef4ee;
  color: #2f6b48;
  font-size: 22rpx;
}

.batch-scroll {
  width: 100%;
  white-space: nowrap;
}

.batch-table {
  width: 1310rpx;
  border: 1rpx solid #e7ece7;
  border-radius: 16rpx;
  overflow: hidden;
}

.batch-table .cell {
  flex: none;
  width: 118rpx;
  text-align: left;
}

.batch-table .cell-line {
  width: 70rpx;
  text-align: center;
}

.batch-table .cell-mat {
  width: 90rpx;
}

.batch-table .cell-mode {
  width: 90rpx;
}

.batch-table .cell-cut {
  width: 104rpx;
}

.batch-table .cell-qty {
  width: 130rpx;
  font-weight: 700;
  color: #173e30;
}

.batch-table .cell-scrap {
  width: 120rpx;
}

.batch-table .cell-state {
  width: 260rpx;
  white-space: normal;
}
